on_count":46},{"cell_type":"markdown","source":"## Bivariate Analysis","metadata":{}},{"cell_type":"code","source":"# ── 1. Prompt length vs Answer label (does harder/longer prompt favor certain answers?) \nfig, axes = plt.subplots(1, 2, figsize=(15, 5))\n\nsns.boxplot(data=train, x=\"answer\", y=\"prompt_len\", order=[\"A\",\"B\",\"C\",\"D\",\"E\"],\n            palette=\"Set2\", ax=axes[0])\naxes[0].set_title(\"Prompt Length vs Answer Label\")\naxes[0].set_xlabel(\"Correct Answer\")\naxes[0].set_ylabel(\"Prompt character length\")\n\n# ── 2. Correct option length vs answer label (is the correct answer systematically longer?)\n# Build a column: length of the correct option text\ndef correct_option_len(row):\n    return len(str(row[row[\"answer\"]]))\n\ntrain[\"correct_option_len\"] = train.apply(correct_option_len, axis=1)\n\nsns.boxplot(data=train, x=\"answer\", y=\"correct_option_len\", order=[\"A\",\"B\",\"C\",\"D\",\"E\"],\n            palette=\"pastel\", ax=axes[1])\naxes[1].set_title(\"Correct Option Text Length vs Answer Label\")\naxes[1].set_xlabel(\"Correct Answer\")\naxes[1].set_ylabel(\"Correct option character length\")\nplt.tight_layout()\nplt.show()\n\n\n# ── 3. Heatmap: avg option length per answer label ────────────────────────────\nopt_len_by_answer = (\n    train.groupby(\"answer\")[[\"A_len\",\"B_len\",\"C_len\",\"D_len\",\"E_len\"]]\n    .mean().round(1)\n)\nfig, ax = plt.subplots(figsize=(10, 4))\nsns.heatmap(opt_len_by_answer, annot=True, fmt=\".0f\", cmap=\"YlOrRd\",\n            linewidths=0.5, ax=ax)\nax.set_title(\"Avg Option Length (chars) for Each Correct-Answer Class\")\nax.set_xlabel(\"Option\")\nax.set_ylabel(\"Correct Answer Label\")\nplt.tight_layout()\nplt.show()\n\nprint(\"\\nAvg option lengths by correct answer:\\n\", opt_len_by_answer)\n\n\n# ── 4. Are options of equal length? (positional bias check) ──────────────────\n# Compute rank of correct option by length within each row\ndef len_rank_of_correct(row):\n    lengths = {lbl: len(str(row[lbl])) for lbl in [\"A\",\"B\",\"C\",\"D\",\"E\"]}\n    sorted_lbls = sorted(lengths, key=lengths.get, reverse=True)\n    return sorted_lbls.index(row[\"answer\"]) + 1  # rank 1 = longest\n\ntrain[\"correct_len_rank\"] = train.apply(len_rank_of_correct, axis=1)\n\nfig, ax = plt.subplots(figsize=(7, 4))\ntrain[\"correct_len_rank\"].value_counts().sort_index().plot(kind=\"bar\", ax=ax,\n    color=\"teal\", edgecolor=\"white\")\nax.set_title(\"Rank of Correct Answer by Option Length\\n(1 = longest option)\")\nax.set_xlabel(\"Length rank\")\nax.set_ylabel(\"Count\")\nplt.tight_layout()\nplt.show()\n\nprint(\"\\nIf correct answer is systematically the longest/shortest, that's a useful feature!\")\nprint(train[\"correct_len_rank\"].value_counts().sort_index())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-09T13:43:44.699717Z","iopub.execute_input":"2026-07-09T13:43:44.700142Z","iopub.status.idle":"2026-07-09T13:43:45.755225Z","shell.execute_reply.started":"2026-07-09T13:43:44.700113Z","shell.execute_reply":"2026-07-09T13:43:45.754078Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 1500x500 with 2 Axes>","image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 1000x400 with 2 Axes>","image/png":"\n"},"metadata":{}},{"name":"stdout","text":"\nAvg option lengths by correct answer:\n         A_len  B_len  C_len  D_len  E_len\nanswer                                   \nA       181.4  160.8  160.9  158.4  157.3\nB       156.6  171.2  162.7  159.3  154.7\nC       157.4  153.0  182.3  153.7  154.6\nD       157.6  168.0  164.2  180.3  164.6\nE       172.4  184.1  163.2  165.3  199.7\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 700x400 with 1 Axes>","image/png":"\n"},"metadata":{}},{"name":"stdout","text":"\nIf correct answer is systematically the longest/shortest, that's a useful feature!\ncorrect_len_rank\n1    811\n2    497\n3    279\n4    189\n5    224\nName: count, dtype: int64\n","output_type":"stream"}],"execution_count":47},{"cell_type":"markdown","source":"## Pre processing ","metadata":{}},{"cell_type":"code","source":"# ============================================================\n# CELL 5 — Preprocessing & Feature Engineering\n# ============================================================\n# Key insight from EDA:\n#   - Options are near-identical distractors (same opening phrase,\n#     subtle factual differences) → TF-IDF vs prompt alone is weak\n#   - Correct answer is the LONGEST option ~40% of the time\n#   - We engineer signals that exploit both length and text overlap\n# ============================================================\n\nimport re\nimport numpy as np\nimport pandas as pd\nfrom sklearn.feature_extraction.text import TfidfVectorizer\nfrom sklearn.metrics.pairwise import cosine_similarity\n\nINPUT_DIR = \"/kaggle/input/competitions/smart-mcq-solver-challenge\"\ntrain = pd.read_csv(f\"{INPUT_DIR}/train.csv\")\ntest  = pd.read_csv(f\"{INPUT_DIR}/test.csv\")\n\nOPTIONS = [\"A\", \"B\", \"C\", \"D\", \"E\"]\n\n# ── 1. Text cleaner ───────────────────────────────────────────\ndef clean(text):\n    \"\"\"Lowercase, collapse whitespace. Keep all words (no stopword\n    removal) because subtle word differences matter here.\"\"\"\n    text = str(text).lower().strip()\n    return re.sub(r\"\\s+\", \" \", text)\n\n# ── 2. Feature engineering ────────────────────────────────────\ndef engineer_features(df):\n    df = df.copy()\n\n    # a) Clean text columns\n    df[\"prompt_clean\"] = df[\"prompt\"].apply(clean)\n    for o in OPTIONS:\n        df[f\"{o}_clean\"] = df[o].apply(clean)\n\n    # b) Character length of each option\n    for o in OPTIONS:\n        df[f\"{o}_len\"] = df[o].apply(lambda x: len(str(x)))\n\n    # c) Normalised length rank (0=shortest, 1=longest within each row)\n    for o in OPTIONS:\n        lengths = df[[f\"{o}_len\" for o in OPTIONS]].values  # (N, 5)\n    lengths = df[[f\"{o}_len\" for o in OPTIONS]].values.astype(float)\n    rng = lengths.max(axis=1, keepdims=True) - lengths.min(axis=1, keepdims=True)\n    lengths_norm = (lengths - lengths.min(axis=1, keepdims=True)) / (rng + 1e-9)\n    for i, o in enumerate(OPTIONS):\n        df[f\"{o}_len_norm\"] = lengths_norm[:, i]\n\n    # d) Word-count of prompt\n    df[\"prompt_wc\"] = df[\"prompt_clean\"].apply(lambda x: len(x.split()))\n\n    # e) Jaccard overlap: prompt words ∩ option words\n    for o in OPTIONS:\n        def jaccard(row, opt=o):\n            pw = set(row[\"prompt_clean\"].split())\n            ow = set(row[f\"{opt}_clean\"].split())\n            return len(pw & ow) / (len(pw | ow) + 1e-9)\n        df[f\"{o}_jaccard\"] = df.apply(jaccard, axis=1)\n\n    return df\n\n\nprint(\"Engineering features...\")\ntrain_fe = engineer_features(train)\ntest_fe  = engineer_features(test)\n\n# ── 3. Fit TF-IDF on all text (prompt + all options, train only) ──\nprint(\"Fitting TF-IDF...\")\nall_texts = train_fe[\"prompt_clean\"].tolist()\nfor o in OPTIONS:\n    all_texts += train_fe[f\"{o}_clean\"].tolist()\n\ntfidf = TfidfVectorizer(\n    max_features=30000,\n    ngram_range=(1, 2),\n    sublinear_tf=True      # dampens very frequent terms\n)\ntfidf.fit(all_texts)\n\n# ── 4. TF-IDF cosine similarity: prompt vs each option ────────\ndef add_tfidf_sims(df, tfidf):\n    df = df.copy()\n    prompt_vecs = tfidf.transform(df[\"prompt_clean\"])\n    for i, o in enumerate(OPTIONS):\n        opt_vecs = tfidf.transform(df[f\"{o}_clean\"])\n        # Row-wise dot product (both are L2-normalised inside cosine_similarity)\n        sims = np.array([\n            cosine_similarity(prompt_vecs[j], opt_vecs[j])[0][0]\n            for j in range(len(df))\n        ])\n        df[f\"{o}_tfidf_sim\"] = sims\n    return df\n\nprint(\"Computing TF-IDF similarities (train)...\")\ntrain_fe = add_tfidf_sims(train_fe, tfidf)\nprint(\"Computing TF-IDF similarities (test)...\")\ntest_fe  = add_tfidf_sims(test_fe, tfidf)\n\n# ── 5. Quick sanity check ─────────────────────────────────────\nnew_feats = [c for c in train_fe.columns if c not in train.columns]\nprint(f\"\\n{len(new_feats)} new features added: {new_feats}\")\nprint(\"\\nSample feature values (row 0):\")\nsample_cols = (\n    [f\"{o}_len\" for o in OPTIONS] +\n    [f\"{o}_len_norm\" for o in OPTIONS] +\n    [f\"{o}_jaccard\" for o in OPTIONS] +\n    [f\"{o}_tfidf_sim\" for o in OPTIONS] +\n    [\"answer\"]\n)\nprint(train_fe[sample_cols].head(3).to_string())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-09T13:43:45.756565Z","iopub.execute_input":"2026-07-09T13:43:45.756867Z","iopub.status.idle":"2026-07-09T13:43:56.48647Z","shell.execute_reply.started":"2026-07-09T13:43:45.756842Z","shell.execute_reply":"2026-07-09T13:43:56.485378Z"}},"outputs":[{"name":"stdout","text":"Engineering features...\nFitting TF-IDF...\nComputing TF-IDF similarities (train)...\nComputing TF-IDF similarities (test)...\n\n27 new features added: ['prompt_clean', 'A_clean', 'B_clean', 'C_clean', 'D_clean', 'E_clean', 'A_len', 'B_len', 'C_len', 'D_len', 'E_len', 'A_len_norm', 'B_len_norm', 'C_len_norm', 'D_len_norm', 'E_len_norm', 'prompt_wc', 'A_jaccard', 'B_jaccard', 'C_jaccard', 'D_jaccard', 'E_jaccard', 'A_tfidf_sim', 'B_tfidf_sim', 'C_tfidf_sim', 'D_tfidf_sim', 'E_tfidf_sim']\n\nSample feature values (row 0):\n   A_len  B_len  C_len  D_len  E_len  A_len_norm  B_len_norm  C_len_norm  D_len_norm  E_len_norm  A_jaccard  B_jaccard  C_jaccard  D_jaccard  E_jaccard  A_tfidf_sim  B_tfidf_sim  C_tfidf_sim  D_tfidf_sim  E_tfidf_sim answer\n0    307    258    222    202    191    1.000000    0.577586    0.267241    0.094828         0.0   0.113208   0.102041   0.195122   0.216216   0.116279     0.112462     0.123893     0.260203     0.325863     0.085439      B\n1    406    364    365    407    408    0.954545    0.000000    0.022727    0.977273         1.0   0.060000   0.066667   0.068182   0.058824   0.058824     0.324156     0.317148     0.346616     0.295007     0.273502      A\n2     12     11      9      9      9    1.000000    0.666667    0.000000    0.000000         0.0   0.000000   0.000000   0.000000   0.000000   0.000000     0.000000     0.000000     0.000000     0.000000     0.000000      C\n","output_type":"stream"}],"execution_count":48},{"cell_type":"markdown","source":"## Model from Scratch","metadata":{}},{"cell_type":"code","source":"# ============================================================\n# CELL 6 — Model From Scratch: Weighted Feature Ranker\n# ============================================================\n# This is a hand-crafted scoring model — no neural weights,\n# no pre-trained embeddings. It combines:\n#   1. Normalised option length  (weight 0.6)  ← strongest signal\n#   2. TF-IDF cosine sim (prompt vs option)    (weight 0.2)\n#   3. Jaccard word overlap (prompt vs option) (weight 0.2)\n#\n# Why these weights? Derived from the EDA observation that the\n# correct answer is the longest option ~40% of the time in this\n# dataset (811 / 2000 rows). Length alone gives MAP@3 ≈ 0.54;\n# adding TF-IDF + Jaccard pushes it to ~0.55.\n#\n# Counts as \"from scratch\" because:\n#   - We build the TF-IDF vocabulary from this dataset only\n#   - No pre-trained model weights are loaded\n#   - The scoring formula is hand-designed, not learned\n# ============================================================\n\nimport numpy as np\nimport pandas as pd\nfrom sklearn.model_selection import train_test_split\n\n# ── assumes Cell 5 was run and train_fe / test_fe exist ──────\n\n# ── 1. MAP@3 scorer ──────────────────────────────────────────\ndef apk(actual, predicted, k=3):\n    \"\"\"Average Precision at K for one sample (single correct answer).\"\"\"\n    for i, p in enumerate(predicted[:k]):\n        if p == actual:\n            return 1.0 / (i + 1)   # 1.0 at rank 1, 0.5 at rank 2, 0.33 at rank 3\n    return 0.0\n\ndef mapk(actuals, predictions, k=3):\n    return np.mean([apk(a, p, k) for a, p in zip(actuals, predictions)])\n\n\n# ── 2. Scoring & ranking function ─────────────────────────────\nOPTIONS = [\"A\", \"B\", \"C\", \"D\", \"E\"]\n\ndef predict_top3(df,\n                 w_length=0.6,\n                 w_tfidf=0.2,\n                 w_jaccard=0.2):\n    \"\"\"\n    Score each option with a weighted combination of features,\n    then return top-3 ranked labels per row.\n\n    Parameters\n    ----------\n    w_length   : weight for normalised character length\n    w_tfidf    : weight for TF-IDF cosine similarity vs prompt\n    w_jaccard  : weight for Jaccard word overlap vs prompt\n    \"\"\"\n    preds = []\n    for _, row in df.iterrows():\n        scores = {}\n        for o in OPTIONS:\n            scores[o] = (\n                w_length  * row[f\"{o}_len_norm\"] +\n                w_tfidf   * row[f\"{o}_tfidf_sim\"] +\n                w_jaccard * row[f\"{o}_jaccard\"]\n            )\n        # Sort options by score descending, take top 3\n        ranked = sorted(scores, key=scores.get, reverse=True)\n        preds.append(ranked[:3])\n    return preds\n\n\n# ── 3. Validate on 80/20 hold-out split ──────────────────────\ntr, val = train_test_split(train_fe, test_size=0.2, random_state=42)\n\nval_preds   = predict_top3(val)\nval_actuals = val[\"answer\"].tolist()\n\nmap3 = mapk(val_actuals, val_preds)\nprint(f\"Validation MAP@3 (from-scratch weighted ranker): {map3:.4f}\")\n\n# ── 4. Hit position breakdown ─────────────────────────────────\nhit_at = {1: 0, 2: 0, 3: 0, \"miss\": 0}\nfor actual, pred in zip(val_actuals, val_preds):\n    if actual in pred:\n        hit_at[pred.index(actual) + 1] += 1\n    else:\n        hit_at[\"miss\"] += 1\n\nn = len(val_actuals)\nprint(\"\\nHit position breakdown on validation set:\")\nprint(f\"  Rank 1  (full score 1.00) : {hit_at[1]:4d} rows  ({hit_at[1]/n*100:.1f}%)\")\nprint(f\"  Rank 2  (score 0.50)      : {hit_at[2]:4d} rows  ({hit_at[2]/n*100:.1f}%)\")\nprint(f\"  Rank 3  (score 0.33)      : {hit_at[3]:4d} rows  ({hit_at[3]/n*100:.1f}%)\")\nprint(f\"  Missed  (score 0.00)      : {hit_at['miss']:4d} rows  ({hit_at['miss']/n*100:.1f}%)\")\n\n# ── 5. Ablation: compare individual signals ───────────────────\nprint(\"\\nAblation — single-signal baselines:\")\n\np_len  = predict_top3(val, w_length=1.0, w_tfidf=0.0, w_jaccard=0.0)\np_tfi  = predict_top3(val, w_length=0.0, w_tfidf=1.0, w_jaccard=0.0)\np_jac  = predict_top3(val, w_length=0.0, w_tfidf=0.0, w_jaccard=1.0)\n\nprint(f\"  Length only   MAP@3: {mapk(val_actuals, p_len):.4f}\")\nprint(f\"  TF-IDF only   MAP@3: {mapk(val_actuals, p_tfi):.4f}\")\nprint(f\"  Jaccard only  MAP@3: {mapk(val_actuals, p_jac):.4f}\")\nprint(f\"  Combined      MAP@3: {map3:.4f}  ← best\")\n\n# ── 6. Generate submission ─────────────────────────────────────\nprint(\"\\nGenerating predictions on test set...\")\ntest_preds = predict_top3(test_fe)\n\nsubmission = pd.DataFrame({\n    \"ID\":         test_fe[\"id\"].values,\n    \"Prediction\": [\" \".join(p) for p in test_preds]\n})\n\nout_path = \"/kaggle/working/submission_scratch_ranker.csv\"\nsubmission.to_csv(out_path, index=False)\n\nprint(f\"Saved to {out_path}\")\nprint(f\"Submission shape: {submission.shape}\")\nprint(\"\\nFirst 10 predictions:\")\nprint(submission.head(10).to_string(index=False))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-09T13:43:56.487745Z","iopub.execute_input":"2026-07-09T13:43:56.488115Z","iopub.status.idle":"2026-07-09T13:43:56.722332Z","shell.execute_reply.started":"2026-07-09T13:43:56.488072Z","shell.execute_reply":"2026-07-09T13:43:56.721186Z"}},"outputs":[{"name":"stdout","text":"Validation MAP@3 (from-scratch weighted ranker): 0.5579\n\nHit position breakdown on validation set:\n  Rank 1  (full score 1.00) :  160 rows  (40.0%)\n  Rank 2  (score 0.50)      :   89 rows  (22.2%)\n  Rank 3  (score 0.33)      :   56 rows  (14.0%)\n  Missed  (score 0.00)      :   95 rows  (23.8%)\n\nAblation — sing